# Copy this file to .env and fill in your values.
# DO NOT commit .env to git.

# GCP project to deploy alerts into
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# Optional: billing account ID, used in the Slack billing report link
GCP_BILLING_ACCOUNT=012345-ABCDEF-678901

# Slack incoming webhook URL (https://api.slack.com/apps -> Incoming Webhooks)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# GCP notification channel ID (numeric, from Cloud Monitoring -> Notification channels)
SLACK_CHANNEL_ID=15058480963135784543
